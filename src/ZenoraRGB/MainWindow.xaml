<Window x:Class="ZenoraRGB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zenora RGB" Height="760" Width="1120" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1521" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#302B59" HorizontalAlignment="Left" Margin="0,6,0,14">
                        <TextBlock Text="Z" FontSize="25" FontWeight="Bold" Foreground="#B8AEFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ZENORA RGB" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="UNIFIED LIGHTING" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,30"/>
                    <TextBlock Text="WORKSPACE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" FontSize="16" Foreground="#B9AEFF" Margin="0,0,12,0"/>
                            <TextBlock Text="Lighting Studio" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="12,8,0,8">
                        <Ellipse Width="7" Height="7" Fill="#55D6A5" Margin="0,0,10,0"/>
                        <TextBlock Text="Local-only control" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="ZENORA LINUX PROJECT" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="Prototype 0.1.0 · Windows x64" FontSize="10" Foreground="#718097" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,24,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Lighting Studio" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Control ASUS Aura and MSI Mystic Light from one place." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻  Scan hardware" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#242D40" Click="ScanButton_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="#171F31" BorderBrush="#343458" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="QUICK COLOR" Foreground="#A9B3C6" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border x:Name="ColorPreview" Width="34" Height="34" CornerRadius="9" Background="#8B75FF" BorderBrush="#65718A" BorderThickness="1"/>
                            <TextBox x:Name="HexColorText" Text="#8B75FF" Width="112" Margin="10,0,0,0" VerticalContentAlignment="Center" TextChanged="HexColorText_TextChanged"/>
                            <Button Content="Apply to both" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Margin="10,0,0,0" Click="ApplyBothButton_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Violet" Tag="#8B75FF" Padding="10,6" Margin="0,0,7,0" Click="PresetButton_Click"/>
                            <Button Content="Ice" Tag="#70D8FF" Padding="10,6" Margin="0,0,7,0" Click="PresetButton_Click"/>
                            <Button Content="White" Tag="#FFFFFF" Padding="10,6" Margin="0,0,7,0" Click="PresetButton_Click"/>
                            <Button Content="Red" Tag="#FF465D" Padding="10,6" Margin="0,0,7,0" Click="PresetButton_Click"/>
                            <Button Content="Green" Tag="#53E0A2" Padding="10,6" Click="PresetButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="HEX COLOR" FontSize="9" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="One palette · two vendors" FontSize="12" Foreground="#D2D7E4" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="19" Margin="0,0,9,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" Background="#26304B" CornerRadius="11">
                                    <TextBlock Text="A" Foreground="#A9B8FF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ASUS Aura" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Armoury Crate · Aura SDK COM" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="#0D1420" CornerRadius="9" Padding="12" Margin="0,17,0,12">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="AsusStatusText" Text="Not connected" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="AsusDeviceText" Text="Connect to discover Aura-compatible devices." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Connect ASUS" Background="#6554C8" BorderBrush="#6554C8" Click="ConnectAsusButton_Click"/>
                                <Button Content="Release" Margin="8,0,0,0" Click="ReleaseAsusButton_Click"/>
                            </StackPanel>
                            <TextBlock Text="CONTROL SCOPE" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,7"/>
                            <TextBlock Text="All Aura SDK devices and LED zones" FontSize="12" Foreground="#D4DBE8"/>
                            <TextBlock Text="The SDK takes control while connected. Releasing it returns lighting control to ASUS software." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Button Content="Apply color to ASUS" HorizontalAlignment="Stretch" Background="#242D40" Margin="0,20,0,0" Click="ApplyAsusButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="19" Margin="9,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" Background="#3A292F" CornerRadius="11">
                                    <TextBlock Text="M" Foreground="#FF9AA8" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="MSI Mystic Light" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="MSI Center · Official SDK DLL" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="#0D1420" CornerRadius="9" Padding="12" Margin="0,17,0,12">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="MsiStatusText" Text="SDK not selected" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="MsiDeviceText" Text="Install the official SDK once, then connect to MSI Center." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DownloadMsiSdkButton" Content="Download official SDK" Background="#34304F" BorderBrush="#514A77" Click="DownloadMsiSdkButton_Click"/>
                                    <Button Content="Choose DLL" Margin="8,0,0,0" Click="SelectMsiSdkButton_Click"/>
                                </StackPanel>
                                <Button Content="Connect MSI" Background="#A04458" BorderBrush="#A04458" Margin="0,9,0,0" HorizontalAlignment="Left" Click="ConnectMsiButton_Click"/>
                            </StackPanel>
                            <TextBlock Text="LOCAL SDK PATH" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,19,0,7"/>
                            <TextBlock x:Name="MsiSdkPathText" Text="Not configured" FontSize="10" Foreground="#D4DBE8" TextWrapping="Wrap" MaxHeight="38"/>
                            <TextBlock Text="LED ZONE" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,7"/>
                            <ComboBox x:Name="MsiZoneCombo" DisplayMemberPath="DisplayName" Height="36"/>
                            <Button Content="Apply color to selected MSI zone" HorizontalAlignment="Stretch" Background="#242D40" Margin="0,15,0,0" Click="ApplyMsiButton_Click"/>
                            <Button Content="Release MSI SDK" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="ReleaseMsiButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#0E1521" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock Text="ACTIVITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="56" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" Text="Ready. Connect ASUS Aura or configure the MSI SDK to begin." FontSize="10" Foreground="#ADB8CA" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
