<Window x:Class="ZenoraRGB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zenora RGB" Height="790" Width="1180" MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0E1521" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="44" Height="44" CornerRadius="14" Background="#302B59" HorizontalAlignment="Left" Margin="0,7,0,15">
                        <TextBlock Text="Z" FontSize="27" FontWeight="Bold" Foreground="#B8AEFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ZENORA RGB" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="UNIFIED LIGHTING ENGINE" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,35"/>
                    <TextBlock Text="WORKSPACE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="13" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" FontSize="17" Foreground="#B9AEFF" Margin="0,0,12,0"/>
                            <TextBlock Text="Lighting Studio" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="12,10,0,8">
                        <Ellipse Width="7" Height="7" Fill="#55D6A5" Margin="0,0,10,0"/>
                        <TextBlock Text="Local hardware control" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBlock Text="One engine for compatible ASUS, MSI, Corsair and other RGB devices." FontSize="11" Foreground="#AAB5C8" TextWrapping="Wrap" Margin="12,10,5,0" LineHeight="18"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,5">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="ZENORA LINUX PROJECT" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="v0.3.0 · Offline bundle · Windows x64" FontSize="10" Foreground="#718097" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,25,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Lighting Studio" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="One offline package. No Armoury Crate, MSI Center or internet connection required after download." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1B2638" BorderBrush="#34435A" BorderThickness="1" CornerRadius="10" Padding="12,9" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#F5C76B" Margin="0,0,9,0"/>
                        <TextBlock x:Name="StatusText" Text="Engine not connected" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="#171F31" BorderBrush="#343458" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ZENORA RGB ENGINE" Foreground="#A9B3C6" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="EngineText" Text="All native prerequisites are embedded in this EXE and will be prepared locally." FontSize="13" Foreground="#E4E8F1" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DriverText" Text="PawnIO and Microsoft Visual C++ are bundled; Windows UAC approval is required for driver installation." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect and scan" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="18,0,0,0" Click="ConnectButton_Click"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*"/>
                    <ColumnDefinition Width="0.88*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="19" Margin="0,0,9,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Detected hardware" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="DeviceCountText" Text="No devices scanned yet" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="↻  Refresh" Padding="11,7" VerticalAlignment="Center" Click="RefreshButton_Click"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#0D1420" CornerRadius="9" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="RGB CONTROLLER" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                                <ComboBox x:Name="DeviceCombo" DisplayMemberPath="DisplayName" Height="42" Margin="0,7,0,0" VerticalContentAlignment="Center" IsEnabled="False" SelectionChanged="DeviceCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Background="#0D1420" CornerRadius="9" Padding="13">
                            <StackPanel>
                                <TextBlock Text="DEVICE DETAILS" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="SelectedDeviceText" Text="Connect to OpenRGB to discover supported devices." FontSize="12" Foreground="#D4DBE8" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                <TextBlock Text="Detected devices are controlled through the local OpenRGB engine. Hardware compatibility depends on the exact controller and firmware." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,15,0,0" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Row="3" Content="Apply color to selected device" HorizontalAlignment="Stretch" Background="#242D40" Margin="0,13,0,0" Click="ApplySelectedButton_Click"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="19" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Color studio" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Choose a color and apply it to one or every detected controller." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18" TextWrapping="Wrap"/>
                        <Border Background="#0D1420" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="QUICK COLOR" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border x:Name="ColorPreview" Width="38" Height="38" CornerRadius="10" Background="#8B75FF" BorderBrush="#65718A" BorderThickness="1"/>
                                    <TextBox x:Name="HexColorText" Text="#8B75FF" Width="115" Margin="10,0,0,0" VerticalContentAlignment="Center" TextChanged="HexColorText_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="PRESETS" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,9"/>
                        <WrapPanel>
                            <Button Content="Violet" Tag="#8B75FF" Padding="11,7" Margin="0,0,7,7" Click="PresetButton_Click"/>
                            <Button Content="Ice" Tag="#70D8FF" Padding="11,7" Margin="0,0,7,7" Click="PresetButton_Click"/>
                            <Button Content="White" Tag="#FFFFFF" Padding="11,7" Margin="0,0,7,7" Click="PresetButton_Click"/>
                            <Button Content="Red" Tag="#FF465D" Padding="11,7" Margin="0,0,7,7" Click="PresetButton_Click"/>
                            <Button Content="Green" Tag="#53E0A2" Padding="11,7" Margin="0,0,7,7" Click="PresetButton_Click"/>
                            <Button Content="Amber" Tag="#FFB84D" Padding="11,7" Margin="0,0,7,7" Click="PresetButton_Click"/>
                        </WrapPanel>
                        <Button Content="Apply to all detected devices" HorizontalAlignment="Stretch" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Margin="0,18,0,0" Click="ApplyAllButton_Click"/>
                        <TextBlock Text="ADVANCED NOTES" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,23,0,8"/>
                        <TextBlock Text="OpenRGB, PawnIO and the Visual C++ runtime are embedded in this single EXE. Setup is offline; Windows may request UAC approval or a restart." FontSize="10" Foreground="#AAB5C8" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="#0E1521" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock Text="ACTIVITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="62" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" Text="Ready. Connect to scan RGB hardware." FontSize="10" Foreground="#ADB8CA" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>